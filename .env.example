# Where the org files live on this host (mounted read-only).
ORG_DIR=/srv/org
# The public name Caddy serves, for example journal.example.com
SITE_ADDRESS=journal.example.com

# From: docker compose run --rm introspect hash-password
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=

# The Kev server on the Mac mini. Leave empty to run the reader without grading.
KEV_URL=http://mac-mini:8009
KEV_MODEL=kev-latest

# Optional. Defaults shown.
# SCAN_INTERVAL=2m
# EXCLUDE=identities.org,crypto.org,finance*.org,invoices/**,bib/**,data/**,tmp/**
# RUBRIC=/data/rubric.json
