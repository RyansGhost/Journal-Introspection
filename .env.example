# Where the org files live on this host (mounted read-only).
ORG_DIR=/srv/org
# The public name Caddy serves, for example journal.example.com
SITE_ADDRESS=journal.example.com

# From: docker compose run --rm introspect hash-password
AUTH_PASSWORD_HASH=
AUTH_TOTP_SECRET=

# The Kev server, on another machine on the network. Use its LAN IP address:
# names like model-server.local often do not resolve inside a container. Leave KEV_URL empty to
# run the reader without grading.
KEV_URL=http://192.168.1.50:8009
KEV_MODEL=kev-latest
# The name grades are stored under. Change it when you swap the model Kev
# serves, and every entry is graded again (old grades are kept).
GRADE_LABEL=kev-0.8b

# Files never indexed, listed, searched or served. Comma-separated globs,
# relative to ORG_DIR; "dir/**" covers a whole directory. This replaces the
# built-in list, which is the line below. Add your own private files here.
EXCLUDE=private/**,secret*.org,*.gpg

# Optional. Defaults shown.
# SCAN_INTERVAL=2m
# RUBRIC=/data/rubric.json
